<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AFConnect.Launcher.App" RequestedThemeVariant="Light">
  <Application.Styles>
    <SimpleTheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI, Segoe UI" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Background" Value="#E5E3DF" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#77746E" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#77746E" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="18,12" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#BDBAB4" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#111111" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="#111111" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F47721" />
      <Setter Property="BorderBrush" Value="#F47721" />
      <Setter Property="Foreground" Value="#111111" />
    </Style>
    <Style Selector="Button.chrome">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="MinWidth" Value="40" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="10" />
      <Setter Property="Background" Value="#F6F5F2" />
    </Style>
    <Style Selector="ComboBox">
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="12" />
      <Setter Property="Background" Value="#F6F5F2" />
    </Style>
  </Application.Styles>
</Application>
