{
  "MongoConnectionString": "mongodb://127.0.0.1:27017",
  "MongoDatabase": "assaultfire",
  "MongoLocalProcess": {
    "AutoStart": true,
    "Executable": "database/bin/mongod.exe",
    "DataDirectory": "database/data",
    "StartupTimeoutSeconds": 30,
    "ShutdownTimeoutSeconds": 30
  },
  "ClientRoot": "../AF_2014",
  "PrivateKeyPath": "secrets/PRIVATE.PEM",
  "ProxyRoot": "../Proxy",
  "ListenAddress": "127.0.0.1",
  "PublicAddress": "127.0.0.1",
  "ActiveUin": 10001,
  "MatchBackend": "Afdev",
  "MatchRuntime": {
    "BioBots": {
      "Enabled": false,
      "RecordPlayerRoutes": false
    },
    "AfdevRuntimeRoot": "../AF_2014",
    "ReservedRuntimeRoots": ["../AF_2014", "../AF_2014"],
    "ReservedRuntimeExecutables": ["Binaries/Win32/TGame_AFDEV.exe", "Binaries/Win32/TGame_AFDEV2.exe"],
    "AfdevExecutable": "Binaries/Win32/TGame_AFDEV.exe",
    "ManifestPath": "data/afdev-reserved.manifest.json",
    "InstancesRoot": "runtime/matches",
    "MaxInstances": 2,
    "PublicPortBase": 65008,
    "TargetPortBase": 7777,
    "StartupTimeoutSeconds": 90,
    "MaxStartupAttempts": 3
  },
  "RemoteConnect": {
    "Enabled": true,
    "ListenAddress": "127.0.0.1",
    "Port": 9443,
    "LocalRolePort": 65005,
    "LocalZonePort": 65006,
    "ServerCertificatePath": "secrets/connect-server.pfx",
    "ServerCertificatePasswordEnvironment": "AF_CONNECT_CERT_PASSWORD",
    "AllowedClientCertificateSha256": [],
    "ExpectedApClientSha256": ""
  }
}
